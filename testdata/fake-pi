# Minimal pi --mode rpc stub for tests: ack each prompt then idle.
# Invoked as `bash testdata/fake-pi` (see PiConfig.BinaryArgs); no exec bit needed.
# shellcheck shell=bash
set -eu
printf '%s' "$*" > "$BARNABY_SESSION_DIR/pi.args"

case "$*" in
  *--never-read*)
    while :; do sleep 300; done
    ;;
esac

while IFS= read -r line; do
  case "$line" in
    *'"type":"prompt"'*|*'"type": "prompt"'*)
      # The room-context extension command records without a turn.
      case "$line" in
        *'"message":"/room-context unhandled'*)
          # Without the extension, Pi starts a turn instead.
          printf '%s\n' '{"type":"response","command":"prompt","success":true,"data":{"disposition":"started"}}'
          printf '%s\n' '{"type":"agent_start"}'
          continue
          ;;
        *'"message":"/room-context '*)
          printf '%s\n' "$line" >> "$BARNABY_SESSION_DIR/room_context.log"
          printf '%s\n' '{"type":"response","command":"prompt","success":true,"data":{"disposition":"handled"}}'
          continue
          ;;
      esac
      # When the prompt asks for it, fork a long-lived grandchild and
      # record its PID so the test can verify stopPi reaps the whole
      # process tree, not just the fake-pi leader. Mirrors real pi
      # running a slow bash tool when shutdown arrives.
      case "$line" in
        *spawn-child*)
          sleep 300 &
          printf '%s' "$!" > "$BARNABY_SESSION_DIR/child.pid"
          ;;
      esac
      printf '%s\n' '{"type":"response","command":"prompt","success":true}'
      printf '%s\n' '{"type":"agent_start"}'
      # Return reaction control tags for worker integration tests.
      case "$line" in
        *reaction-only-test*)
          printf '%s\n' '{"type":"agent_end","messages":[{"role":"assistant","content":[{"type":"text","text":"<react id=\"$event-1\">👍</react>"}],"stopReason":"end_turn"}]}'
          continue
          ;;
        *reaction-send-to-test*)
          printf '%s\n' '{"type":"agent_end","messages":[{"role":"assistant","content":[{"type":"text","text":"<send-to>!other:matrix.org</send-to>\n<react id=\"$event-1\">❤️</react>\nHello from other room"}],"stopReason":"end_turn"}]}'
          continue
          ;;
        *mcp-image-test*)
          printf '%s\n' "{\"type\":\"agent_end\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Here it is<sendfile>$BARNABY_SESSION_DIR/image.png</sendfile><sendfile>$BARNABY_SESSION_DIR/notes.txt</sendfile>\"}],\"stopReason\":\"end_turn\"}]}"
          continue
          ;;
        *tool-use-test*)
          printf '%s\n' '{"type":"tool_execution_start","toolName":"read","args":{"path":"/tmp/one"}}'
          printf '%s\n' '{"type":"tool_execution_end","toolName":"read"}'
          printf '%s\n' '{"type":"tool_execution_start","toolName":"bash","args":{"command":"true"}}'
          printf '%s\n' '{"type":"tool_execution_end","toolName":"bash"}'
          printf '%s\n' '{"type":"agent_end","messages":[{"role":"assistant","content":[{"type":"text","text":"Tool work complete"}],"stopReason":"end_turn"}]}'
          continue
          ;;
      esac
      case "$line" in
        *provider-error-test*)
          printf '%s\n' '{"type":"agent_end","messages":[{"role":"assistant","content":[],"stopReason":"error","errorMessage":"provider unavailable"}]}'
          continue
          ;;
        *hang-test*)
          continue
          ;;
        *silent-test*)
          printf '%s\n' '{"type":"agent_end","messages":[{"role":"assistant","content":[{"type":"text","text":"NO_REPLY"}],"stopReason":"end_turn"}]}'
          continue
          ;;
      esac
      # Return <send-to> in the assistant reply when the prompt contains
      # "send-to-test".
      case "$line" in
        *send-to-test*)
          printf '%s\n' '{"type":"agent_end","messages":[{"role":"assistant","content":[{"type":"text","text":"<send-to>!other:matrix.org</send-to>Hello from other room"}],"stopReason":"end_turn"}]}'
          continue
          ;;
      esac
      printf '%s\n' '{"type":"agent_end","messages":[{"role":"assistant","content":[{"type":"text","text":"ok"}],"stopReason":"end_turn"}]}'
      ;;
    *'"type":"compact"'*|*'"type": "compact"'*)
      printf '%s\n' 'compact' >> "$BARNABY_SESSION_DIR/compact.log"
      printf '%s\n' '{"type":"response","command":"compact","success":true,"data":{"tokensBefore":1,"summary":"s"}}'
      ;;
    *'"type":"get_session_stats"'*|*'"type": "get_session_stats"'*)
      tokens=$(cat "$BARNABY_SESSION_DIR/context_tokens" 2>/dev/null || echo 0)
      session_file=${current_session:-$BARNABY_SESSION_DIR/session.jsonl}
      printf '%s\n' "{\"type\":\"response\",\"command\":\"get_session_stats\",\"success\":true,\"data\":{\"sessionFile\":\"$session_file\",\"contextUsage\":{\"tokens\":$tokens,\"contextWindow\":200000,\"percent\":10}}}"
      ;;
    *'"type":"new_session"'*|*'"type": "new_session"'*)
      printf '%s\n' 'new_session' >> "$BARNABY_SESSION_DIR/new_session.log"
      # Each new session gets a distinct file so MCP tests can tell them apart.
      current_session="$BARNABY_SESSION_DIR/session-$(wc -l < "$BARNABY_SESSION_DIR/new_session.log" | tr -d ' ').jsonl"
      printf '%s\n' '{"type":"response","command":"new_session","success":true,"data":{"cancelled":false}}'
      ;;
    *'"type":"set_model"'*)
      model=$(printf '%s' "$line" | sed 's/.*"modelId":"\([^"]*\)".*/\1/')
      printf '%s\n' "$model" >> "$BARNABY_SESSION_DIR/set_model.log"
      case "$model" in
        missing-model)
          printf '%s\n' '{"type":"response","command":"set_model","success":false,"error":"Model not found: missing-model"}'
          continue
          ;;
      esac
      printf '%s\n' '{"type":"response","command":"set_model","success":true,"data":{}}'
      ;;
    *'"type":"switch_session"'*)
      current_session=$(printf '%s' "$line" | sed 's/.*"sessionPath":"\([^"]*\)".*/\1/')
      printf '%s\n' "$current_session" >> "$BARNABY_SESSION_DIR/switch_session.log"
      case "$current_session" in
        *cancel-switch*)
          printf '%s\n' '{"type":"response","command":"switch_session","success":true,"data":{"cancelled":true}}'
          continue
          ;;
      esac
      printf '%s\n' '{"type":"response","command":"switch_session","success":true,"data":{"cancelled":false}}'
      ;;
  esac
done
